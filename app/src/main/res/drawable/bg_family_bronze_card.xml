<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Bronze Metallic Outer Frame -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#F8CBA6"
                android:centerColor="#A06A42"
                android:endColor="#5C3A21"
                android:type="linear" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <!-- Inner Bronze Gradient Body -->
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#80724828"
                android:centerColor="#C0B07D56"
                android:endColor="#905C3A21"
                android:type="linear" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</layer-list>
