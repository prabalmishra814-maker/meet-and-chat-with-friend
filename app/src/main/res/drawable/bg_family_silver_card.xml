<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Silver Metallic Outer Frame -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#F0F4F8"
                android:centerColor="#9AA5B1"
                android:endColor="#486581"
                android:type="linear" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <!-- Inner Silver Gradient Body -->
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#80627D98"
                android:centerColor="#C0BAC7D5"
                android:endColor="#90486581"
                android:type="linear" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</layer-list>
