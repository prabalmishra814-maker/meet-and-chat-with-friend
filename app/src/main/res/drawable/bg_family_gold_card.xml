<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Gold Metallic Outer Frame -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#FFE58F"
                android:centerColor="#D49E35"
                android:endColor="#8A5A13"
                android:type="linear" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <!-- Inner Gold Gradient Body -->
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#80B88A24"
                android:centerColor="#C0DCA838"
                android:endColor="#908A5A13"
                android:type="linear" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</layer-list>
