<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main_gradient">

    <!-- Header Bar (Top Navigation & Actions) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Top Navigation Tabs (Popular, Following, Recent) -->
        <LinearLayout
            android:id="@+id/llTabs"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Popular Tab -->
            <LinearLayout
                android:id="@+id/tabPopular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvPopular"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="Popular"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp" />

                <View
                    android:id="@+id/indicatorPopular"
                    android:layout_width="22dp"
                    android:layout_height="3dp"
                    android:layout_marginTop="3dp"
                    android:background="@drawable/bg_indicator_gradient" />
            </LinearLayout>

            <!-- Following Tab -->
            <LinearLayout
                android:id="@+id/tabFollowing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvFollowing"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="Following"
                    android:textColor="#80FFFFFF"
                    android:textSize="16sp" />

                <View
                    android:id="@+id/indicatorFollowing"
                    android:layout_width="22dp"
                    android:layout_height="3dp"
                    android:layout_marginTop="3dp"
                    android:background="@drawable/bg_indicator_gradient"
                    android:visibility="invisible" />
            </LinearLayout>

        </LinearLayout>

        <!-- Top Right Action Icons -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Trophy / Leaderboard Icon -->
            <ImageView
                android:id="@+id/ivTrophy"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:contentDescription="Leaderboard"
                android:focusable="true"
                android:src="@drawable/_1000108149_removebg_preview" />

            <!-- Search Icon -->
            <ImageView
                android:id="@+id/ivSearch"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_icon_circle_accent"
                android:clickable="true"
                android:contentDescription="Search"
                android:focusable="true"
                android:padding="6dp"
                android:src="@drawable/ic_search"
                app:tint="#FFFFFF" />

            <!-- Notification Icon Container -->
            <FrameLayout
                android:id="@+id/flNotification"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_icon_circle_accent"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/ivNotification"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:contentDescription="Notification"
                    android:src="@drawable/message_home_entry_friend_ic" />

                <View
                    android:id="@+id/notifBadgeDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="2dp"
                    android:layout_marginEnd="2dp"
                    android:background="@drawable/circle_yellow"
                    android:visibility="visible" />
            </FrameLayout>

            <!-- Add / Create Room Icon -->
            <ImageView
                android:id="@+id/ivAdd"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_icon_circle_accent"
                android:clickable="true"
                android:contentDescription="Add Room"
                android:focusable="true"
                android:padding="6dp"
                android:src="@drawable/ic_plus_gradient" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Horizontal Category Chips Bar -->
    <HorizontalScrollView
        android:id="@+id/hsvCategoryChips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingHorizontal="16dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@+id/header">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="4dp">

            <!-- 🔥 Hot Chip -->
            <TextView
                android:id="@+id/chipHot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_wallet_chip_selected"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-bold"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:text="🔥 Hot"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <!-- India Chip -->
            <TextView
                android:id="@+id/chipIndia"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_wallet_chip_unselected"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:text="India"
                android:textColor="#D0FFFFFF"
                android:textSize="13sp" />

            <!-- Saudi Arabia Chip -->
            <TextView
                android:id="@+id/chipSaudi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_wallet_chip_unselected"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:text="Saudi Arabia"
                android:textColor="#D0FFFFFF"
                android:textSize="13sp" />

            <!-- Nepal Chip -->
            <TextView
                android:id="@+id/chipNepal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_wallet_chip_unselected"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:text="Nepal"
                android:textColor="#D0FFFFFF"
                android:textSize="13sp" />

            <!-- Kuwait Chip -->
            <TextView
                android:id="@+id/chipKuwait"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_wallet_chip_unselected"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:text="Kuwait"
                android:textColor="#D0FFFFFF"
                android:textSize="13sp" />

        </LinearLayout>
    </HorizontalScrollView>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/hsvCategoryChips">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="90dp">

            <!-- Banner Image Slider Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cvBanner"
                android:layout_width="0dp"
                android:layout_height="170dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="#141E33"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <com.denzcoskun.imageslider.ImageSlider
                    android:id="@+id/image_slider"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:iss_auto_cycle="true"
                    app:iss_delay="1000"
                    app:iss_period="1000"
                    app:iss_text_align="CENTER" />

            </androidx.cardview.widget.CardView>

            <!-- Rooms Grid RecyclerView (2 Columns Grid) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvRooms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:paddingHorizontal="14dp"
                app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                app:spanCount="2"
                app:layout_constraintTop_toBottomOf="@+id/cvBanner"
                tools:listitem="@layout/item_room" />

            <!-- Progress Loading Indicator -->
            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:indeterminateTint="#40E0D0"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cvBanner" />

            <!-- Empty State Message -->
            <TextView
                android:id="@+id/tvNoRooms"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:fontFamily="sans-serif-medium"
                android:text="No rooms available"
                android:textColor="#88FFFFFF"
                android:textSize="14sp"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cvBanner" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>