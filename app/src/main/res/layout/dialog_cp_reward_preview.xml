<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_daily_reward_dialog"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Top Header Bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tvPreviewTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="CP Reward Preview"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnClosePreview"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="4dp"
            android:src="@drawable/ic_close" />
    </RelativeLayout>

    <!-- Badge / Status -->
    <TextView
        android:id="@+id/tvPreviewBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_level_badge_cyan"
        android:paddingHorizontal="10dp"
        android:paddingVertical="3dp"
        android:text="UNLOCKED (TESTING) ✨"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold" />

    <!-- SVGA Live Player Preview Box -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="#130B17"
        app:cardCornerRadius="16dp"
        app:strokeColor="#50FF69B4"
        app:strokeWidth="1dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <com.opensource.svgaplayer.SVGAImageView
                android:id="@+id/svgaPreviewPlayer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_centerInParent="true"
                app:autoPlay="true"
                app:loopCount="0" />

            <ProgressBar
                android:id="@+id/pbPreviewLoading"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_centerInParent="true"
                android:indeterminateTint="#FF69B4" />

            <TextView
                android:id="@+id/btnReplayAnim"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"
                android:layout_marginBottom="12dp"
                android:background="@drawable/chip_room_bg"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="▶ Replay Animation"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:textStyle="bold" />

        </RelativeLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Description -->
    <TextView
        android:id="@+id/tvPreviewDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:text="Exclusive CP entrance effect animation when entering a voice chat room."
        android:textColor="#D0FFFFFF"
        android:textSize="13sp" />

    <!-- Action Button (Equip / Unequip) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPreviewAction"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="18dp"
        android:text="Equip Animation"
        android:textAllCaps="false"
        android:textColor="#050E1E"
        android:textSize="15sp"
        android:textStyle="bold"
        app:backgroundTint="#FFD700"
        app:cornerRadius="24dp" />

</LinearLayout>
