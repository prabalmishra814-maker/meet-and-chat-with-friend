<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_agency_card_glass"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <!-- Host Avatar -->
    <FrameLayout
        android:layout_width="52dp"
        android:layout_height="52dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivHostAvatar"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:scaleType="centerCrop"
            android:src="@drawable/app_create_room_ic"
            app:shapeAppearanceOverlay="@style/CircleImage"
            app:strokeColor="#FFD700"
            app:strokeWidth="1.5dp" />

        <TextView
            android:id="@+id/tvLiveStatusDot"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_gravity="bottom|end"
            android:background="@drawable/bg_green_dot" />
    </FrameLayout>

    <!-- Host Info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvHostName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:maxLength="18"
                android:text="Host Name"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvHostStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_agency_badge_pending"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="LIVE"
                android:textColor="#FFD700"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvHostProfileId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif"
            android:text="ID: 100234"
            android:textColor="#94A3B8"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvMonthlyCoins"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="🪙 250,000 Coins"
                android:textColor="#FFD700"
                android:textSize="12.5sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="6dp"
                android:text="•"
                android:textColor="#64748B" />

            <TextView
                android:id="@+id/tvActiveHours"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="⏱️ 18.5 hrs"
                android:textColor="#CBD5E1"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Options Button -->
    <ImageView
        android:id="@+id/btnHostOptions"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="More Options"
        android:padding="6dp"
        android:src="@drawable/ic_more_vert"
        app:tint="#FFD700" />

</LinearLayout>
