<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_img_cp">

    <!-- Top Header Bar (Fixed at Top) -->
    <RelativeLayout
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:minHeight="56dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:paddingHorizontal="16dp">

            <!-- Back Button -->
            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:padding="8dp"
                android:src="@drawable/ic_back_arrow" />

            <!-- Title -->
            <TextView
                android:id="@+id/tvHeaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:shadowColor="#80000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:text="CP Level"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- Help Info Button -->
            <ImageView
                android:id="@+id/btnHelp"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:padding="8dp"
                android:src="@drawable/ic_help_question_circle" />
        </RelativeLayout>

    </RelativeLayout>

    <!-- Fixed Top Arch / Stage Area (Pinned, Non-Scrolling) -->
    <RelativeLayout
        android:id="@+id/stageContainer"
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:layout_below="@id/headerBar"
        android:layout_marginTop="0dp">

        <!-- Arch Columns & Roof Outline Frame -->
        <View
            android:layout_width="260dp"
            android:layout_height="220dp"
            android:layout_centerHorizontal="true"
            android:background="@drawable/bg_cp_dialog_frame"
            android:alpha="0.3" />

        <!-- Left Navigation Arrow -->
        <ImageView
            android:id="@+id/btnPrevLevel"
            android:layout_width="55dp"
            android:layout_height="54dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp"
            android:clickable="true"
            android:focusable="true"
            android:scaleType="fitCenter"
            android:src="@drawable/left_arrow" />

        <!-- Right Navigation Arrow -->
        <ImageView
            android:id="@+id/btnNextLevel"
            android:layout_width="52dp"
            android:layout_height="56dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="12dp"
            android:clickable="true"
            android:focusable="true"
            android:scaleType="fitCenter"
            android:src="@drawable/right_arrow" />

        <!-- Center Heart Crest Badge Stage -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:orientation="vertical">

            <!-- Winged Heart Crest -->
            <FrameLayout
                android:layout_width="150dp"
                android:layout_height="110dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/heart_cp" />

                <TextView
                    android:id="@+id/tvStageLevelText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center|bottom"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_level_badge_cyan"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="3dp"
                    android:text="LV.4"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <!-- Podium Stage Base -->
        </LinearLayout>

        <!-- Status Banner at Bottom of Stage -->
        <TextView
            android:id="@+id/tvStageStatus"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_alignParentBottom="true"
            android:background="@drawable/bg_cp_arch_gained_banner"
            android:gravity="center"
            android:text="Gained"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

    </RelativeLayout>

    <!-- Scrollable Content Area Below Stage -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/stageContainer"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Main Privileges Grid Card Container -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_cp_privilege_frame"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- Privileges 3-Column Grid -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvPrivileges"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</RelativeLayout>
