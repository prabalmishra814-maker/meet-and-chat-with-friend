<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_comment_sheet"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <!-- Top Drag Handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_indicator_gradient" />

    <!-- Header Row (Title & Rescan/Refresh Button) -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="Room Music Player"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Refresh / Rescan Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRefreshMusic"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="68dp"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:paddingHorizontal="8dp"
            android:paddingVertical="0dp"
            android:text="↺"
            android:textColor="#00FFC6"
            android:textSize="20sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Currently Playing Song Banner -->
    <TextView
        android:id="@+id/tvMusicDialogSongTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_room_top_user_info"
        android:ellipsize="marquee"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:gravity="center"
        android:marqueeRepeatLimit="marquee_forever"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        android:singleLine="true"
        android:text="No Song Playing"
        android:textColor="#00FFC6"
        android:textSize="14.5sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvMusicTrackCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:gravity="center"
        android:text="Device Music (Scanning...)"
        android:textColor="#B0B0B0"
        android:textSize="11.5sp" />

    <!-- Loading Indicator -->
    <ProgressBar
        android:id="@+id/progressBarMusicLoading"
        style="?android:attr/progressBarStyleSmall"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginVertical="12dp"
        android:indeterminateTint="#FF007A"
        android:visibility="gone" />

    <!-- Empty State / Permission Container -->
    <LinearLayout
        android:id="@+id/llMusicEmptyState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="8dp"
        android:background="@drawable/bg_glass_card"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvMusicEmptyMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Permission required to access audio files on your device."
            android:textColor="#D0D0D0"
            android:textSize="12.5sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGrantMusicPermission"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginTop="10dp"
            android:text="Grant Storage Permission"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            app:backgroundTint="#FF007A"
            app:cornerRadius="19dp" />
    </LinearLayout>

    <!-- Scrollable Device Track List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMusicList"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingVertical="2dp"
        tools:listitem="@layout/item_device_music_track" />

    <!-- Main Player Controls (Previous, Play/Pause, Next) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:orientation="horizontal">

        <!-- Previous Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMusicPrev"
            style="@style/Widget.MaterialComponents.Button.Icon"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginEnd="16dp"
            android:contentDescription="Previous Song"
            android:padding="0dp"
            app:backgroundTint="#2A223D"
            app:cornerRadius="25dp"
            app:icon="@drawable/ic_skip_previous"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="26dp"
            app:iconTint="#FFFFFF"
            app:strokeColor="#FF007A"
            app:strokeWidth="1dp" />

        <!-- Play / Pause Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMusicPlayPause"
            style="@style/Widget.MaterialComponents.Button.Icon"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:contentDescription="Play/Pause"
            android:padding="0dp"
            app:backgroundTint="#FF007A"
            app:cornerRadius="30dp"
            app:icon="@drawable/ic_play"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="30dp"
            app:iconTint="#FFFFFF" />

        <!-- Next Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMusicNext"
            style="@style/Widget.MaterialComponents.Button.Icon"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginStart="16dp"
            android:contentDescription="Next Song"
            android:padding="0dp"
            app:backgroundTint="#2A223D"
            app:cornerRadius="25dp"
            app:icon="@drawable/ic_skip_next"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="26dp"
            app:iconTint="#FFFFFF"
            app:strokeColor="#FF007A"
            app:strokeWidth="1dp" />

    </LinearLayout>

    <!-- Volume Control Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:text="Music Volume"
                android:textColor="#FFFFFF"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvMusicVolumeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="80%"
                android:textColor="#FFB703"
                android:textSize="13.5sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <SeekBar
            android:id="@+id/seekBarMusicVolume"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:max="100"
            android:progress="80"
            android:progressTint="#00FFC6"
            android:thumbTint="#FF007A" />
    </LinearLayout>

    <!-- Action Buttons (Select Custom Song & Stop) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:orientation="horizontal">

        <!-- Custom Audio Picker -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDialogSelectSong"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:text="Pick File"
            android:textColor="#FFFFFF"
            android:textSize="12.5sp"
            app:backgroundTint="#2A223D"
            app:cornerRadius="21dp"
            app:strokeColor="#00FFC6"
            app:strokeWidth="1dp" />

        <!-- Stop Music Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDialogStopMusic"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="Stop Music"
            android:textColor="#FFFFFF"
            android:textSize="12.5sp"
            app:backgroundTint="#2A223D"
            app:cornerRadius="21dp"
            app:strokeColor="#FF007A"
            app:strokeWidth="1dp" />

    </LinearLayout>

</LinearLayout>
