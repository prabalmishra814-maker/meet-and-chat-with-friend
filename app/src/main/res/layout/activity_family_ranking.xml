<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/faimly_background_2">

    <!-- Fullscreen Background Image -->
    <ImageView
        android:id="@+id/ivFullscreenBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/faimly_background_2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Top Navigation Header Bar -->
    <FrameLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintTop_toTopOf="parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingHorizontal="12dp">

            <!-- Back Button -->
            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="Back"
                android:focusable="true"
                android:padding="8dp"
                android:src="@drawable/ic_back_arrow"
                app:tint="#FFFFFF" />

            <!-- Center Tabs: My family | Family square -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tabMyFamily"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:text="My family"
                    android:textColor="#A0FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tabFamilySquare"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:text="Family square"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Right Help Button -->
            <ImageView
                android:id="@+id/btnHelp"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="Help"
                android:focusable="true"
                android:padding="4dp"
                android:src="@drawable/ic_help_question_circle"
                app:tint="#FFFFFF" />
        </RelativeLayout>
    </FrameLayout>

    <!-- Scrollable Main Body Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingBottom="64dp"
        app:layout_constraintBottom_toTopOf="@id/bottomStatusContainer"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <!-- Hero Banner: Trophy Header Container -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="355dp"
                android:layout_marginTop="4dp">

                <!-- Family Ranking Gold Title Banner Image -->
                <ImageView
                    android:layout_width="361dp"
                    android:layout_height="109dp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="4dp"
                    android:adjustViewBounds="true"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/family_name_badges" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp">

                <TextView
                    android:id="@+id/btnFilterDaily"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_family_filter_active"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="Daily"
                    android:textColor="#3D2600"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnFilterWeekly"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_family_filter_inactive"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="Weekly"
                    android:textColor="#E2E8F0"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnFilterSeason"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_family_filter_inactive"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="Season"
                    android:textColor="#E2E8F0"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Date Selector Row (< 2026-10-13 >) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_date_selector_glass"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp">

                <ImageView
                    android:id="@+id/btnPrevDate"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:clickable="true"
                    android:contentDescription="Previous"
                    android:focusable="true"
                    android:src="@drawable/ic_back_arrow"
                    app:tint="#FFD700" />

                <TextView
                    android:id="@+id/tvSelectedDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:text="2026-10-13"
                    android:textColor="#FFD700"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/btnNextDate"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:clickable="true"
                    android:contentDescription="Next"
                    android:focusable="true"
                    android:rotation="180"
                    android:src="@drawable/ic_back_arrow"
                    app:tint="#FFD700" />
            </LinearLayout>

            <!-- Family Leaderboard RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvFamilyLeaderboard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                tools:listitem="@layout/item_family_rank_card" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Fixed Family Membership Status Bar -->
    <FrameLayout
        android:id="@+id/bottomStatusContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="58dp"
        android:background="@drawable/bg_family_bottom_bar"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/tvBottomFamilyStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Not joining the family"
            android:textColor="#A0FFFFFF"
            android:textSize="14.5sp"
            android:textStyle="bold" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
