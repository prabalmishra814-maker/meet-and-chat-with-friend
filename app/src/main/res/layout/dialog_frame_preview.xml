<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_glass_gift_dialog"
    android:padding="24dp">

    <!-- Top Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="Frame Live Preview"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnClose"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:contentDescription="Close"
            android:src="@drawable/ic_close"
            app:tint="#88FFFFFF" />
    </RelativeLayout>

    <!-- Center Preview Container -->
    <FrameLayout
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp">

        <!-- User Avatar Placeholder -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivPreviewAvatar"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:layout_gravity="center"
            android:scaleType="centerCrop"
            android:src="@drawable/logo_placeholder"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />

        <!-- Static Image Frame Overlay -->
        <ImageView
            android:id="@+id/ivStaticFramePreview"
            android:layout_width="270dp"
            android:layout_height="270dp"
            android:layout_gravity="center"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <!-- SVGA Animated Frame Overlay -->
        <com.opensource.svgaplayer.SVGAImageView
            android:id="@+id/svgaFramePreview"
            android:layout_width="280dp"
            android:layout_height="280dp"
            android:layout_gravity="center"
            app:autoPlay="true"
            app:loopCount="0" />
    </FrameLayout>

    <!-- Item Details -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/tvPreviewFrameName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Golden Emperor Frame"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPreviewBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/chip_charm_bg"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="ROYAL"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvPreviewDescription"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="Majestic Golden Emperor Avatar Frame"
        android:textColor="#B0FFFFFF"
        android:textSize="13sp"
        android:layout_marginBottom="20dp" />

    <!-- Action Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPreviewAction"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:backgroundTint="#FFD700"
        android:text="Buy for 500"
        android:textColor="#050E1E"
        android:textSize="16sp"
        android:textStyle="bold"
        app:cornerRadius="26dp" />

</LinearLayout>
