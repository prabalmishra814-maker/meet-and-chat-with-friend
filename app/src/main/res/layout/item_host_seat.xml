<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingTop="6dp"
    android:paddingBottom="10dp">

    <!-- Avatar & Seat Container -->
    <FrameLayout
        android:id="@+id/avatarContainer"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Empty Seat Background / Circle -->
        <View
            android:id="@+id/vEmptySeatBg"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_empty_seat" />

        <!-- Empty Seat Chair Icon -->
        <ImageView
            android:id="@+id/ivAddIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:contentDescription="Seat"
            android:src="@drawable/seat"
            android:visibility="visible" />

        <!-- Speaking Indicator Pulsing Ring Overlay -->
        <View
            android:id="@+id/speakingIndicator"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_empty_seat"
            android:visibility="gone" />

        <!-- Occupied User Circular Avatar -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivSeatAvatar"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="center"
            android:scaleType="centerCrop"
            android:src="@drawable/logo_placeholder"
            android:visibility="gone"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />

        <!-- Profile Frame / Horns Overlay -->
        <ImageView
            android:id="@+id/ivSeatFrame"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <!-- Animated SVGA Profile Frame Overlay -->
        <com.opensource.svgaplayer.SVGAImageView
            android:id="@+id/svgaSeatFrame"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:visibility="gone"
            app:autoPlay="true"
            app:loopCount="0" />

        <!-- Locked / Closed Seat Overlay -->
        <ImageView
            android:id="@+id/ivSeatLocked"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_lock"
            android:visibility="gone"
            app:tint="#FF5252" />

        <!-- Mic Status Icon (bottom-right of avatar) -->
        <ImageView
            android:id="@+id/ivMicStatus"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="4dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_glass_icon_pill"
            android:backgroundTint="#80000000"
            android:elevation="4dp"
            android:padding="3dp"
            android:src="@drawable/ic_mic_on"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Host User Name -->
    <TextView
        android:id="@+id/tvSeatName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="Host"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold" />

</LinearLayout>