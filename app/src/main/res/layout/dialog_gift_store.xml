<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_comment_sheet"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="20dp">

    <!-- Top Drag Handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_indicator_gradient" />

    <!-- Header Row -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="Room Gifts 🎁"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- Send Button at Top Right -->
        <LinearLayout
            android:id="@+id/btnSendGiftAction"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_send_button_glow"
            android:clickable="true"
            android:elevation="4dp"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Send"
                android:textColor="#FFFFFF"
                android:textSize="13.5sp"
                android:textStyle="bold" />
        </LinearLayout>

    </RelativeLayout>

    <!-- Gifts Grid (4 Columns) -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="4"
        android:useDefaultMargins="true">

        <!-- Gift Item 1: Aladdin Magic Lamp (50 Coins) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardGiftAladdin"
            android:layout_width="0dp"
            android:layout_height="105dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="#2A223D"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="#FF007A"
            app:strokeWidth="1.5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="4dp">

                <FrameLayout
                    android:layout_width="42dp"
                    android:layout_height="42dp">

                    <ImageView
                        android:id="@+id/imgGiftAladdin"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Aladdin"
                        android:scaleType="fitCenter"
                        android:src="@drawable/aladin" />

                    <com.opensource.svgaplayer.SVGAImageView
                        android:id="@+id/svgaPreviewAladdin"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:visibility="gone"
                        app:autoPlay="true"
                        app:loopCount="0" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="Aladdin"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="50 🪙"
                    android:textColor="#FFD700"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Gift Item 2: Walkthrough (100 Coins) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardGiftHeart"
            android:layout_width="0dp"
            android:layout_height="105dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="#2A223D"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="#20FFFFFF"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="4dp">

                <FrameLayout
                    android:layout_width="42dp"
                    android:layout_height="42dp">

                    <ImageView
                        android:id="@+id/imgGiftHeart"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Heart"
                        android:scaleType="fitCenter"
                        android:src="@drawable/gift2" />

                    <com.opensource.svgaplayer.SVGAImageView
                        android:id="@+id/svgaPreviewHeart"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:visibility="gone"
                        app:autoPlay="true"
                        app:loopCount="0" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="Walkthrough"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="100 🪙"
                    android:textColor="#FFD700"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Gift Item 3: Angel (150 Coins) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardGiftBox"
            android:layout_width="0dp"
            android:layout_height="105dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="#2A223D"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="#20FFFFFF"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="4dp">

                <FrameLayout
                    android:layout_width="42dp"
                    android:layout_height="42dp">

                    <ImageView
                        android:id="@+id/imgGiftBox"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Gift Box"
                        android:scaleType="fitCenter"
                        android:src="@drawable/gift3" />

                    <com.opensource.svgaplayer.SVGAImageView
                        android:id="@+id/svgaPreviewBox"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:visibility="gone"
                        app:autoPlay="true"
                        app:loopCount="0" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="Angel"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="150 🪙"
                    android:textColor="#FFD700"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Gift Item 4: Magic Rose (200 Coins) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardGiftRose"
            android:layout_width="0dp"
            android:layout_height="105dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="#2A223D"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="#20FFFFFF"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
