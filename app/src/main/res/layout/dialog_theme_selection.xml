<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_comment_sheet"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <!-- Top Drag Handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_indicator_gradient" />

    <!-- Header Title: Room theme -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Room Theme Store 🎨"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Cyan Active Tab Indicator Line -->
        <View
            android:layout_width="24dp"
            android:layout_height="3dp"
            android:layout_marginTop="4dp"
            android:background="#00E5FF" />
    </LinearLayout>

    <!-- 2 Column Grid for Room Themes -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="2"
        android:useDefaultMargins="true">

        <!-- Theme Card 1: theme1_img (Free) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardThemeCyber"
            android:layout_width="0dp"
            android:layout_height="170dp"
            android:layout_columnWeight="1"
            android:layout_margin="6dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="#2A223D"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="#00E5FF"
            app:strokeWidth="1.5dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/imgPosterTheme1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Theme"
                    android:scaleType="centerCrop"
                    android:src="@drawable/theme1_img" />

                <!-- Price Badge Top Right -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_margin="8dp"
                    android:background="#A0000000"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="FREE"
                    android:textColor="#10B981"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <!-- Bottom Semi-transparent Overlay Strip -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_alignParentBottom="true"
                    android:background="#80000000"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tvUseCyber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Apply Theme"
                        android:textColor="#FFFFFF"
                        android:textSize="13.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </RelativeLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Theme Card 2: theme2_img (50 Coins) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardThemeGalaxy"
            android:layout_width="0dp"
            android:layout_height="170dp"
            android:layout_columnWeight="1"
            android:layout_margin="6dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="#2A223D"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="#20FFFFFF"
            app:strokeWidth="1dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/imgPosterTheme2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Theme"
                    android:scaleType="centerCrop"
                    android:src="@drawable/theme2_img" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_margin="8dp"
                    android:background="#A0000000"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="50 🪙"
                    android:textColor="#FFD700"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_alignParentBottom="true"
                    android:background="#80000000"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tvUseGalaxy"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Buy &amp; Apply"
                        android:textColor="#FFFFFF"
                        android:textSize="13.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </RelativeLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Theme Card 3: theme3_img (100 Coins) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardThemeSunset"
            android:layout_width="0dp"
            android:layout_height="170dp"
            android:layout_columnWeight="1"
            android:layout_margin="6dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="#2A223D"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="#20FFFFFF"
            app:strokeWidth="1dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/imgPosterTheme3"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Theme"
                    android:scaleType="centerCrop"
                    android:src="@drawable/theme3_img" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_margin="8dp"
                    android:background="#A0000000"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="100 🪙"
                    android:textColor="#FFD700"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_alignParentBottom="true"
                    android:background="#80000000"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tvUseSunset"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Buy &amp; Apply"
                        android:textColor="#FFFFFF"
                        android:textSize="13.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </RelativeLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Theme Card 4: Aurora Glass (150 Coins) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardThemeAurora"
            android:layout_width="0dp"
            android:layout_height="170dp"
            android:layout_columnWeight="1"
            android:layout_margin="6dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="#2A223D"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="#20FFFFFF"
            app:strokeWidth="1dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Theme"
                    android:scaleType="centerCrop"
                    android:src="@drawable/bg_main_gradient" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_margin="8dp"
                    android:background="#A0000000"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="150 🪙"
                    android:textColor="#FFD700"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_alignParentBottom="true"
                    android:background="#80000000"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tvUseAurora"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Buy &amp; Apply"
                        android:textColor="#FFFFFF"
                        android:textSize="13.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </RelativeLayout>
        </com.google.android.material.card.MaterialCardView>

    </GridLayout>

</LinearLayout>
