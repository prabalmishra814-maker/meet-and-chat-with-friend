<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="4dp">

    <!-- Avatar & Seat Container -->
    <FrameLayout
        android:id="@+id/avatarContainer"
        android:layout_width="52dp"
        android:layout_height="52dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Empty Seat Background / Circle -->
        <View
            android:id="@+id/vEmptySeatBg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_empty_seat" />

        <!-- Empty Seat Chair Icon -->
        <ImageView
            android:id="@+id/ivAddIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:contentDescription="Seat"
            android:src="@drawable/seat"
            android:visibility="visible" />

        <!-- Speaking Indicator Pulsing Ring Overlay -->
        <View
            android:id="@+id/speakingIndicator"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_empty_seat"
            android:visibility="gone" />

        <!-- Occupied User Circular Avatar -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivSeatAvatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/logo_placeholder"
            android:visibility="gone"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
            app:strokeColor="@color/glass_white"
            app:strokeWidth="1.5dp" />

        <!-- Profile Frame Overlay -->
        <ImageView
            android:id="@+id/ivSeatFrame"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:visibility="gone"
            tools:src="@drawable/_1000092461_removebg_preview" />

        <!-- Locked / Closed Seat Overlay -->
        <ImageView
            android:id="@+id/ivSeatLocked"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_lock"
            android:visibility="gone"
            app:tint="#FF5252" />

        <!-- Mic Status Icon (bottom-right of avatar) -->
        <ImageView
            android:id="@+id/ivMicStatus"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="bottom|end"
            android:elevation="4dp"
            android:padding="2dp"
            android:src="@drawable/ic_mic_on"
            android:visibility="gone" />
    </FrameLayout>

    <!-- User Name or Seat Number Label -->
    <TextView
        android:id="@+id/tvSeatName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="3"
        android:textColor="@color/white"
        android:textSize="10.5sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/avatarContainer" />

</androidx.constraintlayout.widget.ConstraintLayout>
