<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#160033">

    <!-- Top Header Toolbar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="36dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:padding="6dp"
            android:src="@drawable/ic_back_arrow"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#FFFFFF" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:text="Invite To Share Rewards"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Scrollable Body Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingBottom="90dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp">

            <!-- Slot Machine Graphic Header Banner -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="130dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_referral_purple_banner"
                android:padding="12dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:text="Invite To Share Rewards 🎰"
                            android:textColor="#FFD700"
                            android:textSize="19sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="sans-serif-bold"
                            android:text="Free Coins, Win Games!"
                            android:textColor="#E2E8F0"
                            android:textSize="13.5sp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="84dp"
                        android:layout_height="84dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:contentDescription="Casino Slot Machine"
                        android:scaleType="fitCenter"
                        android:src="@drawable/gift_icon" />
                </RelativeLayout>
            </FrameLayout>

            <!-- Invited Friends & My Code Row -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <!-- Left: Invited Friends Stack -->
                <LinearLayout
                    android:id="@+id/llInvitedFriendsGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="Invited Friends"
                        android:textColor="#D0FFFFFF"
                        android:textSize="13sp" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvInvitedAvatars"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginTop="4dp"
                        android:orientation="horizontal"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
                </LinearLayout>

                <!-- Right: My Invitation Code Pill -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:gravity="end"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="My Invitation Code"
                        android:textColor="#D0FFFFFF"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:id="@+id/btnCopyCodePill"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/chip_charm_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingHorizontal="16dp">

                        <TextView
                            android:id="@+id/tvCodePillText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:textColor="#FFFFFF"
                            android:textSize="14.5sp"
                            tools:text="100934032 📋" />
                    </LinearLayout>
                </LinearLayout>

            </RelativeLayout>

            <!-- Tab Container (Invite Tasks | New User Tasks) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_referral_task_card"
                android:padding="3dp">

                <TextView
                    android:id="@+id/tabInviteTasks"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/chip_charm_bg"
                    android:fontFamily="sans-serif-bold"
                    android:gravity="center"
                    android:text="Invite Tasks"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tabNewUserTasks"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/chip_room_bg"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="New User Tasks"
                    android:textColor="#80FFFFFF"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Invite Tasks Tab Header (Rebate Cards) -->
            <LinearLayout
                android:id="@+id/llInviteTasksHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <!-- Rebate Card 1: Friends Recharge 150% Rebate (Golden) -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="76dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_referral_gold_banner">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:paddingHorizontal="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:fontFamily="sans-serif-bold"
                            android:text="Friends Recharge 150% Rebate"
                            android:textColor="#FFE680"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/tvRechargeRebateCount"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:background="@drawable/bg_level_badge_pill"
                            android:fontFamily="sans-serif-bold"
                            android:gravity="center"
                            android:paddingHorizontal="16dp"
                            android:text="🪙 0 ›"
                            android:textColor="#FFFFFF"
                            android:textSize="13.5sp" />
                    </RelativeLayout>
                </FrameLayout>

                <!-- Rebate Card 2: Friends' Lucky Game Rebate (Purple) -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="76dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_referral_purple_banner">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:paddingHorizontal="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:fontFamily="sans-serif-bold"
                            android:text="Friends' Lucky Game Rebate"
                            android:textColor="#00FFC6"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/tvGameRebateCount"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:background="@drawable/chip_room_bg"
                            android:fontFamily="sans-serif-bold"
                            android:gravity="center"
                            android:paddingHorizontal="16dp"
                            android:text="🍀 0 ›"
                            android:textColor="#FFFFFF"
                            android:textSize="13.5sp" />
                    </RelativeLayout>
                </FrameLayout>

            </LinearLayout>

            <!-- New User Tasks Tab Header (Room Launch Card + Progress Capsule) -->
            <LinearLayout
                android:id="@+id/llNewUserTasksHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Room Launch Banner Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#210042"
                    app:cardCornerRadius="18dp"
                    app:strokeColor="#A0FFD700"
                    app:strokeWidth="1.5dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="12dp">

                        <ImageView
                            android:id="@+id/ivRocketIcon"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:contentDescription="Rocket"
                            android:src="@drawable/gift_icon" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="10dp"
                            android:layout_marginEnd="8dp"
                            android:layout_toEndOf="@+id/ivRocketIcon"
                            android:layout_toStartOf="@+id/btnGoRoomLaunch"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvRoomIdTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-black"
                                android:text="Room ID: 61553"
                                android:textColor="#FFD700"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tvRoomDesc"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:ellipsize="end"
                                android:fontFamily="sans-serif-medium"
                                android:maxLines="2"
                                android:text="is about to launch, go and see it"
                                android:textColor="#E2E8F0"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btnGoRoomLaunch"
                            android:layout_width="64dp"
                            android:layout_height="36dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:background="@drawable/bg_referral_gold_pill"
                            android:fontFamily="sans-serif-bold"
                            android:text="Go"
                            android:textAllCaps="false"
                            android:textColor="#050E1E"
                            android:textSize="13sp" />

                    </RelativeLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Progress Capsule (🍀 0 >) -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_referral_purple_banner">

                    <TextView
                        android:id="@+id/tvNewUserProgressCapsule"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:background="@drawable/chip_room_bg"
                        android:fontFamily="sans-serif-bold"
                        android:gravity="center"
                        android:paddingHorizontal="18dp"
                        android:text="🍀 0 ›"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp" />
                </FrameLayout>

            </LinearLayout>

            <!-- Task List RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvInviteTasks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_invite_task" />

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="20dp"
                android:indeterminateTint="#00FFC6" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Floating "Bind Your Inviter" Orange Pill Button -->
    <LinearLayout
        android:id="@+id/btnBindInviterPill"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="72dp"
        android:background="@drawable/bg_referral_orange_pill"
        android:clickable="true"
        android:elevation="8dp"
        android:focusable="true"
        android:gravity="center"
        android:paddingHorizontal="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="6dp"
            android:contentDescription="Bind Inviter"
            android:src="@drawable/ic_person"
            app:tint="#FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:text="Bind Your Inviter"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Golden "Invite Friends" 3D Bottom Button -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnInviteFriendsBottom"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_referral_gold_pill"
        android:elevation="10dp"
        android:fontFamily="sans-serif-black"
        android:text="🚀 Invite Friends"
        android:textAllCaps="false"
        android:textColor="#050E1E"
        android:textSize="17sp"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>