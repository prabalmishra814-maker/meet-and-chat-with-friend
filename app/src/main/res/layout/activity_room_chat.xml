<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_room_gradient">

    <!-- Custom Background View (Ambient bubbles, background, etc.) -->
    <com.roomchatapps.Pmishra.AudioRoomBackgroundView
        android:id="@+id/audioRoomBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <FrameLayout
            android:id="@+id/giftOverlayContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="false"
            android:elevation="10dp"
            android:focusable="false" />

        <!-- Global Realtime SVGA Gift Banner Overlay Container -->
        <FrameLayout
            android:id="@+id/globalBannerGiftContainer"
            android:layout_width="match_parent"
            android:layout_height="102dp"
            android:layout_gravity="top"
            android:layout_marginTop="85dp"
            android:elevation="30dp"
            android:visibility="gone">

            <com.opensource.svgaplayer.SVGAImageView
                android:id="@+id/globalSvgaBannerPlayer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                app:clearsAfterStop="true"
                app:loopCount="1" />

            <TextView
                android:id="@+id/globalTvBannerNotice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:letterSpacing="0.01"
                android:paddingHorizontal="40dp"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />
        </FrameLayout>
    </com.roomchatapps.Pmishra.AudioRoomBackgroundView>

    <!-- Top Header Bar using LinearLayout -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingTop="36dp"
        android:paddingBottom="8dp"
        android:elevation="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- User / Room Info & Trophy Container (Left Column) -->
        <LinearLayout
            android:id="@+id/layoutLeftHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- User / Room Info Container (Left Pill) -->
            <LinearLayout
                android:id="@+id/layoutUserInfo"
                android:layout_width="wrap_content"
                android:layout_height="45dp"
                android:background="@drawable/bg_room_top_user_info"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp">

                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/ivRoomAvatar"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/logo_placeholder"
                    app:civ_border_width="0dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvRoomName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:text="AmStudio"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/layoutRoomDetails"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/layoutRoomId"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvRoomId"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:singleLine="true"
                                android:text="ID:13672983"
                                android:textColor="#B0FFFFFF"
                                android:textSize="10.5sp" />

                            <ImageView
                                android:id="@+id/btnCopyRoomId"
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:layout_marginStart="3dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:clickable="true"
                                android:contentDescription="Copy Room ID"
                                android:focusable="true"
                                android:src="@drawable/ic_copy"
                                app:tint="#B0FFFFFF" />
                        </LinearLayout>

                        <!-- Live Members Count Section -->
                        <LinearLayout
                            android:id="@+id/layoutMemberCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="7dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:id="@+id/ivMemberIcon"
                                android:layout_width="13dp"
                                android:layout_height="13dp"
                                android:src="@drawable/ic_members"
                                android:contentDescription="Members"
                                app:tint="#B0FFFFFF" />

                            <TextView
                                android:id="@+id/tvMemberCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="3dp"
                                android:text="1"
                                android:textColor="#B0FFFFFF"
                                android:textSize="10.5sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>

                <!-- Header Plus / Add Button -->

            </LinearLayout>

            <!-- Row below layoutUserInfo: Trophy + Music option -->
            <LinearLayout
                android:id="@+id/layoutHeaderSubRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginStart="5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Trophy / Rank Badge -->
                <LinearLayout
                    android:id="@+id/layoutRoomTrophy"
                    android:layout_width="wrap_content"
                    android:layout_height="25dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/ivTrophyIcon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_trophy"
                        android:contentDescription="Trophy Icon" />

                    <TextView
                        android:id="@+id/tvTrophyCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="0.0B"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/ivTrophyArrow"
                        android:layout_width="18dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="2dp"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="#B0FFFFFF"
                        android:contentDescription="Arrow" />
                </LinearLayout>

                <!-- Music Option (Host Only) -->
                <LinearLayout
                    android:id="@+id/layoutRoomMusic"
                    android:layout_width="wrap_content"
                    android:layout_height="25dp"
                    android:layout_marginStart="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <ImageView
                        android:id="@+id/ivMusicOptionIcon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_music"
                        android:contentDescription="Music Icon" />

                    <TextView
                        android:id="@+id/tvMusicOptionText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="Music"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/ivMusicOptionArrow"
                        android:layout_width="18dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="2dp"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="#B0FFFFFF"
                        android:contentDescription="Arrow" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- Action Icons (Right Side) -->
        <LinearLayout
            android:id="@+id/layoutRightActions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/more"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginEnd="12dp"
                android:scaleType="centerCrop"
                android:contentDescription="Badge"
                android:src="@drawable/setting" />

            <ImageView
                android:id="@+id/btnRoomShare"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginEnd="12dp"
                android:contentDescription="Share"
                android:src="@drawable/ic_room_share" />

            <ImageView
                android:id="@+id/btnRoomClose"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:contentDescription="Close"
                android:src="@drawable/ic_room_power" />
        </LinearLayout>

    </LinearLayout>

    <!-- Live Music Bar Widget -->
    <LinearLayout
        android:id="@+id/layoutMusicWidget"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_room_top_user_info"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <ImageView
            android:id="@+id/ivMusicWave"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="Music Icon"
            android:src="@drawable/ic_speaker_on"
            app:tint="#00FFC6" />

        <TextView
            android:id="@+id/tvMusicTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:ellipsize="end"
            android:maxLength="22"
            android:singleLine="true"
            android:text="Playing: Song.mp3"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnWidgetMusicPause"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_control_button"
            android:contentDescription="Stop Music"
            android:padding="4dp"
            android:src="@drawable/ic_room_power"
            app:tint="#FF007A" />
    </LinearLayout>

    <!-- Golden Gift Banner Container (Positioned in Top Seats / Profile Area) -->
    <FrameLayout
        android:id="@+id/bannerGiftContainer"
        android:layout_width="match_parent"
        android:layout_height="102dp"
        android:layout_marginTop="2dp"
        android:elevation="25dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <!-- Golden Banner SVGA View -->
        <com.opensource.svgaplayer.SVGAImageView
            android:id="@+id/svgaBannerPlayer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            app:clearsAfterStop="true"
            app:loopCount="1" />

        <!-- Dynamic Gift Text Overlay Inside Banner -->
        <TextView
            android:id="@+id/tvBannerNotice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:letterSpacing="0.01"
            android:paddingHorizontal="40dp"
            android:paddingVertical="4dp"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:shadowColor="#E0000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="6"
            tools:text="akash sent Walkthrough" />
    </FrameLayout>

    <!-- User Entry Banner Container (Red Packet SVGA for Room Join Entry) -->
    <FrameLayout
        android:id="@+id/bannerEntryContainer"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginTop="2dp"
        android:elevation="26dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <!-- Entry Banner SVGA View -->
        <com.opensource.svgaplayer.SVGAImageView
            android:id="@+id/svgaEntryBannerPlayer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:clearsAfterStop="true"
            app:loopCount="1" />

        <!-- Dynamic Entry Notice Text Overlay Inside Banner -->
        <TextView
            android:id="@+id/tvEntryBannerNotice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.02"
            android:paddingHorizontal="48dp"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textSize="14.5sp"
            android:textStyle="bold"
            android:shadowColor="#A0000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="5"
            tools:text="Roy Rupesh entered the room" />
    </FrameLayout>

    <!-- SEAT LAYOUT FIX -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSeats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingHorizontal="12dp"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@id/topBar" />

    <!-- Chat Area -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvChatMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="1dp"
        android:layout_marginBottom="12dp"
        android:clipToPadding="false"
        android:paddingBottom="12dp"
        android:overScrollMode="never"
        app:stackFromEnd="true"
        app:layout_constraintTop_toBottomOf="@id/rvSeats"
        app:layout_constraintBottom_toTopOf="@id/bottomMenuBar" />

    <!-- Bottom Menu Bar -->
    <LinearLayout
        android:id="@+id/bottomMenuBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="10dp"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- 1. Input Box Pill ("Say Hi...") -->
        <LinearLayout
            android:id="@+id/btnChat"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_chat_input_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Say Hi..."
                android:textColor="#A0FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- 2. Mic Button -->
        <ImageView
            android:id="@+id/btnMic"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_control_button"
            android:clickable="true"
            android:focusable="true"
            android:padding="10dp"
            android:src="@drawable/ic_mic_on" />

        <!-- 3. Speaker Button -->
        <ImageView
            android:id="@+id/btnSpeaker"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_control_button"
            android:clickable="true"
            android:focusable="true"
            android:padding="10dp"
            android:src="@drawable/ic_speaker_on" />

        <!-- 4. Spin & Gift Buttons Stack -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <!-- Spin Wheel Icon (Positioned directly above Gift icon) -->
            <ImageView
                android:id="@+id/btnSpinWheel"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_control_button"
                android:clickable="true"
                android:contentDescription="Lucky Spin"
                android:focusable="true"
                android:padding="4dp"
                android:src="@drawable/lucky_spin_wheel"
                android:visibility="gone" />

            <!-- Gift Button -->
            <ImageView
                android:id="@+id/btnGift"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_control_button"
                android:clickable="true"
                android:contentDescription="Gift"
                android:focusable="true"
                android:padding="8dp"
                android:src="@drawable/gift_icon" />
        </LinearLayout>

        <!-- Retained hidden view for Activity reference -->
        <ImageView
            android:id="@+id/btnMore"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <!-- Retained hidden views for Activity references -->
        <ImageView
            android:id="@+id/btnSettings"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/btnGame"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Overlay for Animations -->
    <com.opensource.svgaplayer.SVGAImageView
        android:id="@+id/svgaPlayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="20dp"
        android:visibility="gone"
        app:autoPlay="false"
        app:loopCount="1" />

</androidx.constraintlayout.widget.ConstraintLayout>
