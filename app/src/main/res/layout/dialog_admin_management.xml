<?xml version="1.0" encoding="utf-8"?>
<!-- ROOM ADMIN FIX: BottomSheet dialog for Administrator Management -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_glass_more_panel"
    android:orientation="vertical"
    android:paddingHorizontal="18dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <!-- Top Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="5dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_indicator_gradient" />

    <!-- Top Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="10dp"
            android:src="@drawable/ic_admin_shield" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Administrator Management 🛡️"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAdminManagementSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Promote room members or remove admin permissions"
                android:textColor="#A0FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Admin Count Badge -->
        <TextView
            android:id="@+id/tvAdminCountBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_room_top_user_info"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="0 Admins"
            android:textColor="#00FFC6"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Room Members List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAdminMembers"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:clipToPadding="false"
        android:overScrollMode="never" />

</LinearLayout>
