<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_room_gradient">

    <!-- Custom Background View (Ambient bubbles, background, etc.) -->
    <com.roomchatapps.Pmishra.AudioRoomBackgroundView
        android:id="@+id/audioRoomBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <FrameLayout
            android:id="@+id/giftOverlayContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="false"
            android:elevation="10dp"
            android:focusable="false" />
    </com.roomchatapps.Pmishra.AudioRoomBackgroundView>

    <!-- Top Header Bar using LinearLayout -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingTop="36dp"
        android:paddingBottom="8dp"
        android:elevation="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- User / Room Info Container (Left Pill) -->
        <LinearLayout
            android:id="@+id/layoutUserInfo"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_room_top_user_info"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp">

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/ivRoomAvatar"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/logo_placeholder"
                app:civ_border_width="0dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvRoomName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="AmStudio"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/layoutRoomId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvRoomId"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:text="ID:13672983"
                        android:textColor="#B0FFFFFF"
                        android:textSize="10.5sp" />

                    <ImageView
                        android:id="@+id/btnCopyRoomId"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginStart="4dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:contentDescription="Copy Room ID"
                        android:focusable="true"
                        android:src="@drawable/ic_copy"
                        app:tint="#B0FFFFFF" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>

        <!-- Action Icons (Right Side) -->
        <LinearLayout
            android:id="@+id/layoutRightActions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/more"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginEnd="12dp"
                android:scaleType="centerCrop"
                android:contentDescription="Badge"
                android:src="@drawable/setting" />

            <ImageView
                android:id="@+id/btnRoomShare"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginEnd="12dp"
                android:contentDescription="Share"
                android:src="@drawable/ic_room_share" />

            <ImageView
                android:id="@+id/btnRoomClose"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:contentDescription="Close"
                android:src="@drawable/ic_room_power" />
        </LinearLayout>

    </LinearLayout>

    <!-- Live Music Bar Widget -->
    <LinearLayout
        android:id="@+id/layoutMusicWidget"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_room_top_user_info"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <ImageView
            android:id="@+id/ivMusicWave"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="Music Icon"
            android:src="@drawable/ic_speaker_on"
            app:tint="#00FFC6" />

        <TextView
            android:id="@+id/tvMusicTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:ellipsize="end"
            android:maxLength="22"
            android:singleLine="true"
            android:text="Playing: Song.mp3"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnWidgetMusicPause"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_control_button"
            android:contentDescription="Stop Music"
            android:padding="4dp"
            android:src="@drawable/ic_room_power"
            app:tint="#FF007A" />
    </LinearLayout>

    <!-- Golden Gift Banner Container (Positioned in Top Seats / Profile Area) -->
    <FrameLayout
        android:id="@+id/bannerGiftContainer"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginTop="2dp"
        android:elevation="25dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <!-- Golden Banner SVGA View -->
        <com.opensource.svgaplayer.SVGAImageView
            android:id="@+id/svgaBannerPlayer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:clearsAfterStop="true"
            app:loopCount="1" />

        <!-- Dynamic Gift Text Overlay Inside Banner -->
        <TextView
            android:id="@+id/tvBannerNotice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.02"
            android:paddingHorizontal="48dp"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textSize="14.5sp"
            android:textStyle="bold"
            android:shadowColor="#A0000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="5"
            tools:text="akash sent Walkthrough" />
    </FrameLayout>

    <!-- User Entry Banner Container (Red Packet SVGA for Room Join Entry) -->
    <FrameLayout
        android:id="@+id/bannerEntryContainer"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginTop="2dp"
        android:elevation="26dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <!-- Entry Banner SVGA View -->
        <com.opensource.svgaplayer.SVGAImageView
            android:id="@+id/svgaEntryBannerPlayer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:clearsAfterStop="true"
            app:loopCount="1" />

        <!-- Dynamic Entry Notice Text Overlay Inside Banner -->
        <TextView
            android:id="@+id/tvEntryBannerNotice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.02"
            android:paddingHorizontal="48dp"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textSize="14.5sp"
            android:textStyle="bold"
            android:shadowColor="#A0000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="5"
            tools:text="Roy Rupesh entered the room" />
    </FrameLayout>

    <!-- 16 Seats Grid -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSeats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="250dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintVertical_bias="0.25" />

    <!-- Chat Area -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvChatMessages"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="80dp"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Bottom Menu Bar -->
    <LinearLayout
        android:id="@+id/bottomMenuBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- 1. Input Box Pill ("Say Hi...") -->
        <LinearLayout
            android:id="@+id/btnChat"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_chat_input_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Say Hi..."
                android:textColor="#A0FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- 2. Mic Button -->
        <ImageView
            android:id="@+id/btnMic"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_control_button"
            android:clickable="true"
            android:focusable="true"
            android:padding="10dp"
            android:src="@drawable/ic_mic_on" />

        <!-- 3. Speaker Button -->
        <ImageView
            android:id="@+id/btnSpeaker"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_control_button"
            android:clickable="true"
            android:focusable="true"
            android:padding="10dp"
            android:src="@drawable/ic_speaker_on" />

        <!-- 4. Gift Button -->
        <ImageView
            android:id="@+id/btnGift"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_control_button"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/gift_icon" />

        <!-- 5. More Icon Button -->
        <ImageView
            android:id="@+id/btnMore"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_control_button"
            android:clickable="true"
            android:contentDescription="More"
            android:focusable="true"
            android:padding="10dp"
            android:src="@drawable/room_more_ic"
            android:visibility="gone" />

        <!-- Retained hidden views for Activity references -->
        <ImageView
            android:id="@+id/btnSettings"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/btnGame"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Overlay for Animations -->
    <com.opensource.svgaplayer.SVGAImageView
        android:id="@+id/svgaPlayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="20dp"
        android:visibility="gone"
        app:autoPlay="false"
        app:loopCount="1" />

</androidx.constraintlayout.widget.ConstraintLayout>
