<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_cp_dialog_frame"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Privilege Icon -->
    <ImageView
        android:id="@+id/ivDetailIcon"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/ic_privilege_cp_card" />

    <!-- Title -->
    <TextView
        android:id="@+id/tvDetailTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="CP Privilege Title"
        android:textColor="#5A3199"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Level Requirement Badge -->
    <TextView
        android:id="@+id/tvDetailLevel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_level_badge_purple"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        android:text="Unlocked at LV.4"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Description -->
    <TextView
        android:id="@+id/tvDetailDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="Enjoy exclusive CP privilege with your partner once reached required intimacy level."
        android:textColor="#666666"
        android:textSize="14sp" />

    <!-- OK / Close Button -->
    <TextView
        android:id="@+id/btnCloseDetail"
        android:layout_width="160dp"
        android:layout_height="40dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_btn_confirm_gradient"
        android:gravity="center"
        android:text="Got It"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>
