<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    android:background="@drawable/bg_cp_privilege_card"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    android:gravity="center"
    android:minHeight="112dp"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- Privilege Icon Container -->
    <FrameLayout
        android:layout_width="56dp"
        android:layout_height="50dp"
        android:layout_gravity="center">

        <ImageView
            android:id="@+id/ivPrivilegeIcon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_privilege_cp_card" />

        <ImageView
            android:id="@+id/ivLockOverlay"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="top|end"
            android:src="@android:drawable/ic_lock_lock"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Privilege Title -->
    <TextView
        android:id="@+id/tvPrivilegeTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:text="CP Privilege"
        android:textColor="#7A5BAF"
        android:textSize="11sp"
        android:textStyle="bold" />

</LinearLayout>
