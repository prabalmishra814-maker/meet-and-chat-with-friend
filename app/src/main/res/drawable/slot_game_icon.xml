<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="120dp"
    android:height="120dp"
    android:viewportWidth="200"
    android:viewportHeight="200">

    <!-- Golden Crown Base Body -->
    <path
        android:pathData="M 30,145 L 20,60 L 60,95 L 100,40 L 140,95 L 180,60 L 170,145 Z"
        android:strokeWidth="3"
        android:strokeColor="#78350f">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="200"
                android:endY="200"
                android:type="linear">
                <item android:color="#FEF08A" android:offset="0.0" />
                <item android:color="#F59E0B" android:offset="0.4" />
                <item android:color="#B45309" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Bottom Velvet Base -->
    <path
        android:pathData="M 25,145 L 175,145 L 175,165 L 25,165 Z"
        android:fillColor="#581C87"
        android:strokeWidth="2"
        android:strokeColor="#FEF08A" />

    <!-- Center Ruby Gem -->
    <path
        android:pathData="M 100,23 C 107,23 112,28 112,35 C 112,42 107,47 100,47 C 93,47 88,42 88,35 C 88,28 93,23 100,23 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="100"
                android:centerY="35"
                android:gradientRadius="12"
                android:type="radial">
                <item android:color="#FCA5A5" android:offset="0.0" />
                <item android:color="#EF4444" android:offset="0.5" />
                <item android:color="#7F1D1D" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Side Cyan Gems -->
    <path
        android:pathData="M 20,46 C 25,46 29,50 29,55 C 29,60 25,64 20,64 C 15,64 11,60 11,55 C 11,50 15,46 20,46 Z"
        android:fillColor="#06B6D4" />

    <path
        android:pathData="M 180,46 C 185,46 189,50 189,55 C 189,60 185,64 180,64 C 175,64 171,60 171,55 C 171,50 175,46 180,46 Z"
        android:fillColor="#06B6D4" />

    <!-- Sparkle Star Flare -->
    <path
        android:pathData="M 100,10 L 102,18 L 110,20 L 102,22 L 100,30 L 98,22 L 90,20 L 98,18 Z"
        android:fillColor="#FFFFFF" />
</vector>