                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Crown"
                        android:scaleType="fitCenter"
                        android:src="@drawable/gift5" />

                    <com.opensource.svgaplayer.SVGAImageView
                        android:id="@+id/svgaPreviewCrown"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:visibility="gone"
                        app:autoPlay="true"
                        app:loopCount="0" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="Rocket"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="300 🪙"
                    android:textColor="#FFD700"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Gift Item 6: Super Rocket (500 Coins) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardGiftRocket"
            android:layout_width="0dp"
            android:layout_height="105dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="#2A223D"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="#20FFFFFF"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="4dp">

                <FrameLayout
                    android:layout_width="42dp"
                    android:layout_height="42dp">

                    <ImageView
                        android:id="@+id/imgGiftRocket"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Rocket"
                        android:scaleType="fitCenter"
                        android:src="@drawable/gift6" />

                    <com.opensource.svgaplayer.SVGAImageView
                        android:id="@+id/svgaPreviewRocket"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:visibility="gone"
                        app:autoPlay="true"
                        app:loopCount="0" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="Porsche"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="500 🪙"
                    android:textColor="#FFD700"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Gift Item 7: Halloween (1000 Coins) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardGiftSvip"
            android:layout_width="0dp"
            android:layout_height="105dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="#2A223D"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="#20FFFFFF"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="4dp">

                <FrameLayout
                    android:layout_width="42dp"
                    android:layout_height="42dp">

                    <ImageView
                        android:id="@+id/imgGiftSvip"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="SVIP"
                        android:scaleType="fitCenter"
                        android:src="@drawable/gift7" />

                    <com.opensource.svgaplayer.SVGAImageView
                        android:id="@+id/svgaPreviewSvip"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:visibility="gone"
                        app:autoPlay="true"
                        app:loopCount="0" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
