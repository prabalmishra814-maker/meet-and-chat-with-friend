<?xml version="1.0" encoding="utf-8"?>
<!-- ROOM ADMIN FIX: Member item layout for Administrator Management list -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_glass_icon_pill"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <!-- Profile Picture with Glass Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:cardBackgroundColor="#00000000"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:strokeColor="#00E5FF"
        app:strokeWidth="1dp">

        <ImageView
            android:id="@+id/ivAdminProfile"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/logo_placeholder" />

    </com.google.android.material.card.MaterialCardView>

    <!-- User Info Column -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvAdminName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="User Name"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Role Badge Pill -->
            <TextView
                android:id="@+id/tvAdminRoleBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_room_top_user_info"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="MEMBER"
                android:textColor="#00FFC6"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvAdminUserId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="ID: 10001"
            android:textColor="#B0FFFFFF"
            android:textSize="11.5sp" />
    </LinearLayout>

    <!-- Action Button (Make Admin / Remove Admin) -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnAdminAction"
        android:layout_width="105dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_send_button_glow"
        android:paddingHorizontal="8dp"
        android:text="Make Admin"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold" />

</LinearLayout>
