<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_comment_sheet"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <!-- Top Drag Handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_indicator_gradient" />

    <!-- Title & Status -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Room Music Player 🎵"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvMusicDialogSongTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_room_top_user_info"
        android:ellipsize="marquee"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:gravity="center"
        android:marqueeRepeatLimit="marquee_forever"
        android:paddingHorizontal="14dp"
        android:paddingVertical="12dp"
        android:singleLine="true"
        android:text="No Song Playing"
        android:textColor="#00FFC6"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvMusicTrackCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="Device Tracks Loaded"
        android:textColor="#B0B0B0"
        android:textSize="11.5sp" />

    <!-- Main Player Controls (Previous, Play/Pause, Next) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:orientation="horizontal">

        <!-- Previous Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMusicPrev"
            style="@style/Widget.MaterialComponents.Button.Icon"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginEnd="16dp"
            android:padding="0dp"
            app:backgroundTint="#2A223D"
            app:cornerRadius="26dp"
            app:icon="@drawable/ic_skip_previous"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="28dp"
            app:iconTint="#FFFFFF"
            app:strokeColor="#FF007A"
            app:strokeWidth="1dp" />

        <!-- Play / Pause Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMusicPlayPause"
            style="@style/Widget.MaterialComponents.Button.Icon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:padding="0dp"
            app:backgroundTint="#FF007A"
            app:cornerRadius="32dp"
            app:icon="@drawable/ic_play"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="32dp"
            app:iconTint="#FFFFFF" />

        <!-- Next Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMusicNext"
            style="@style/Widget.MaterialComponents.Button.Icon"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="16dp"
            android:padding="0dp"
            app:backgroundTint="#2A223D"
            app:cornerRadius="26dp"
            app:icon="@drawable/ic_skip_next"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="28dp"
            app:iconTint="#FFFFFF"
            app:strokeColor="#FF007A"
            app:strokeWidth="1dp" />

    </LinearLayout>

    <!-- Volume Control Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:text="Music Volume"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvMusicVolumeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="80%"
                android:textColor="#FFB703"
                android:textSize="14sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <SeekBar
            android:id="@+id/seekBarMusicVolume"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:max="100"
            android:progress="80"
            android:progressTint="#00FFC6"
            android:thumbTint="#FF007A" />
    </LinearLayout>

    <!-- Action Buttons (Select Custom Song & Stop) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:orientation="horizontal">

        <!-- Custom Audio Picker -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDialogSelectSong"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:text="Pick File"
            android:textColor="#FFFFFF"
            android:textSize="12.5sp"
            app:backgroundTint="#2A223D"
            app:cornerRadius="22dp"
            app:strokeColor="#00FFC6"
            app:strokeWidth="1dp" />

        <!-- Stop Music Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDialogStopMusic"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="Stop Music"
            android:textColor="#FFFFFF"
            android:textSize="12.5sp"
            app:backgroundTint="#2A223D"
            app:cornerRadius="22dp"
            app:strokeColor="#FF007A"
            app:strokeWidth="1dp" />

    </LinearLayout>

</LinearLayout>
