<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.RoomChat" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Transparent Status Bar matching room theme -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
    </style>

    <style name="Theme.RoomChat" parent="Base.Theme.RoomChat" />

    <style name="CircleImage" parent="">
        <item name="cornerSize">50%</item>
    </style>

    <style name="Rounded16" parent="">
        <item name="cornerSize">16dp</item>
    </style>

    <style name="ShapeAppearance.Material3.Corner.Full" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerSize">50%</item>
    </style>

    <style name="GiftTabTextStyle" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">14.5sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
