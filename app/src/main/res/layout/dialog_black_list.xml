<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_glass_more_panel"
    android:orientation="vertical"
    android:paddingHorizontal="18dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <!-- Top Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="5dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_indicator_gradient" />

    <!-- Top Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Room Blacklist 🚫"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Banned members cannot enter or send messages in this room"
                android:textColor="#A0FFFFFF"
                android:textSize="11.5sp" />
        </LinearLayout>

        <!-- Count Badge -->
        <TextView
            android:id="@+id/tvBlacklistCountBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_room_top_user_info"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="0 Banned"
            android:textColor="#EF4444"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Search Input -->
    <EditText
        android:id="@+id/etSearchBlacklist"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginBottom="12dp"
        android:autofillHints="none"
        android:background="@drawable/edittext_bg"
        android:drawableStart="@drawable/ic_search"
        android:drawablePadding="10dp"
        android:hint="Search banned member by name or ID..."
        android:inputType="text"
        android:maxLines="1"
        android:paddingHorizontal="16dp"
        android:singleLine="true"
        android:textColor="#FFFFFF"
        android:textColorHint="#70FFFFFF"
        android:textSize="13.5sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvBlacklistMembers"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:clipToPadding="false"
        android:overScrollMode="never" />

</LinearLayout>