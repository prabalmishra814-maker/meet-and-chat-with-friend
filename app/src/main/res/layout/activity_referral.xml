<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_ref_screen">

    <!-- Floating Back Button -->
    <ImageView
        android:id="@+id/btnBack"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="28dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Back"
        android:elevation="10dp"
        android:padding="6dp"
        android:src="@drawable/ic_back_arrow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="#FFFFFF" />

    <!-- Scrollable Body Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingTop="28dp"
        android:paddingBottom="90dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp">

            <!-- Top Logo & Subtitle Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="280dp"
                    android:layout_height="64dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="Invite To Share Rewards"
                    android:scaleType="fitCenter"
                    android:src="@drawable/inv_to_share" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif-bold"
                    android:text="Free Coins, Win Games!"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

                <!-- Slot Machine Graphic Banner (Zoomed) -->
                <ImageView
                    android:layout_width="366dp"
                    android:layout_height="182dp"
                    android:layout_marginTop="4dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="Casino Slot Machine Graphic"
                    android:scaleType="fitXY"
                    android:src="@drawable/_777_ref" />

            </LinearLayout>

            <!-- Invited Friends & My Code Row -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <!-- Left: Invited Friends Stack -->
                <LinearLayout
                    android:id="@+id/llInvitedFriendsGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:text="Invited Friends"
                        android:textColor="#FFFFFF"
                        android:textSize="13.5sp" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvInvitedAvatars"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginTop="4dp"
                        android:orientation="horizontal"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
                </LinearLayout>

                <!-- Right: My Invitation Code Pill -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:gravity="end"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:text="My Invitation Code"
                        android:textColor="#FFFFFF"
                        android:textSize="13.5sp" />

                    <LinearLayout
                        android:id="@+id/btnCopyCodePill"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/chip_charm_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingHorizontal="16dp">

                        <TextView
                            android:id="@+id/tvCodePillText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:textColor="#FFFFFF"
                            android:textSize="14.5sp"
                            tools:text="100934032" />
                    </LinearLayout>
                </LinearLayout>

            </RelativeLayout>

            <!-- Tab Container (Invite Tasks | New User Tasks) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_referral_task_card"
                android:padding="3dp">

                <TextView
                    android:id="@+id/tabInviteTasks"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/chip_charm_bg"
                    android:fontFamily="sans-serif-bold"
                    android:gravity="center"
                    android:text="Invite Tasks"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tabNewUserTasks"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/chip_room_bg"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="New User Tasks"
                    android:textColor="#80FFFFFF"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Invite Tasks Tab Header (Rebate Cards) -->
            <LinearLayout
                android:id="@+id/llInviteTasksHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <!-- Rebate Card 1: Friends Recharge 150% Rebate (Golden) -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="90dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_referral_gold_banner">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Recharge Coins Background"
                        android:scaleType="fitXY"
                        android:src="@drawable/coin_ref" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:paddingHorizontal="16dp">

                        <TextView
                            android:id="@+id/tvRechargeTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerHorizontal="true"
                            android:layout_marginTop="10dp"
                            android:fontFamily="sans-serif-bold"
                            android:text="Friends Recharge 150% Rebate"
                            android:textColor="#FFE680"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/tvRechargeRebateCount"
                            android:layout_width="220dp"
                            android:layout_height="36dp"
                            android:layout_below="@+id/tvRechargeTitle"
                            android:layout_centerHorizontal="true"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_referral_dark_yellow_pill"
                            android:fontFamily="sans-serif-bold"
                            android:gravity="center"
                            android:paddingHorizontal="16dp"
                            android:text="🪙 0 ›"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp" />
                    </RelativeLayout>
                </FrameLayout>

                <!-- Rebate Card 2: Friends' Lucky Game Rebate (Purple) -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="90dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_referral_purple_banner">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Lucky Game Background"
                        android:scaleType="fitXY"
                        android:src="@drawable/green_con_ref" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:paddingHorizontal="16dp">

                        <TextView
                            android:id="@+id/tvGameTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerHorizontal="true"
                            android:layout_marginTop="10dp"
                            android:fontFamily="sans-serif-bold"
                            android:text="Friends' Lucky Game Rebate"
                            android:textColor="#00FFC6"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/tvGameRebateCount"
                            android:layout_width="220dp"
                            android:layout_height="36dp"
                            android:layout_below="@+id/tvGameTitle"
                            android:layout_centerHorizontal="true"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_referral_light_green_pill"
                            android:fontFamily="sans-serif-bold"
                            android:gravity="center"
                            android:paddingHorizontal="16dp"
                            android:text="🍀 0 ›"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp" />
                    </RelativeLayout>
                </FrameLayout>

            </LinearLayout>

            <!-- New User Tasks Tab Header (Room Launch Card + Progress Capsule) -->
            <LinearLayout
                android:id="@+id/llNewUserTasksHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Room Launch Banner Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#210042"
                    app:cardCornerRadius="18dp"
                    app:strokeColor="#A0FFD700"
                    app:strokeWidth="1.5dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="12dp">

                        <ImageView
                            android:id="@+id/ivRocketIcon"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:contentDescription="Rocket"
                            android:src="@drawable/gift_icon" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="10dp"
                            android:layout_marginEnd="8dp"
                            android:layout_toEndOf="@+id/ivRocketIcon"
                            android:layout_toStartOf="@+id/btnGoRoomLaunch"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvRoomIdTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-black"
                                android:text="Room ID: 61553"
                                android:textColor="#FFD700"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tvRoomDesc"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:ellipsize="end"
                                android:fontFamily="sans-serif-medium"
                                android:maxLines="2"
                                android:text="is about to launch, go and see it"
                                android:textColor="#E2E8F0"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btnGoRoomLaunch"
                            android:layout_width="64dp"
                            android:layout_height="36dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:background="@drawable/bg_referral_gold_pill"
                            android:fontFamily="sans-serif-bold"
                            android:text="Go"
                            android:textAllCaps="false"
                            android:textColor="#050E1E"
                            android:textSize="13sp" />

                    </RelativeLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Progress Capsule (🍀 0 >) -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_referral_purple_banner">

                    <TextView
                        android:id="@+id/tvNewUserProgressCapsule"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:background="@drawable/chip_room_bg"
                        android:fontFamily="sans-serif-bold"
                        android:gravity="center"
                        android:paddingHorizontal="18dp"
                        android:text="🍀 0 ›"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp" />
                </FrameLayout>

            </LinearLayout>

            <!-- Task List RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvInviteTasks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_invite_task" />

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="20dp"
                android:indeterminateTint="#00FFC6" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Floating "Bind Your Inviter" Orange Pill Badge with 3D Icon -->
    <FrameLayout
        android:id="@+id/btnBindInviterPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="72dp"
        android:clickable="true"
        android:elevation="12dp"
        android:focusable="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Orange Pill Container -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_referral_orange_pill"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:maxLines="2"
                android:text="Bind Your\nInviter"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 3D Person Graphic Floating on Top-Right -->
        <ImageView
            android:layout_width="55dp"
            android:layout_height="67dp"
            android:layout_gravity="top|end"
            android:contentDescription="Bind Inviter"
            android:src="@drawable/bind_inv_person" />

    </FrameLayout>

    <!-- Golden "Invite Friends" 3D Bottom Button -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnInviteFriendsBottom"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_referral_gold_pill"
        android:elevation="10dp"
        android:fontFamily="sans-serif-black"
        android:text="Invite Friends"
        android:textAllCaps="false"
        android:textColor="#050E1E"
        android:textSize="17sp"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>