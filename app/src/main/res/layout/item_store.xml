<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cvStoreContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="#141E33"
    app:cardCornerRadius="20dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Top Badge -->
        <TextView
            android:id="@+id/tvBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:background="@drawable/chip_charm_bg"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="HOT 🔥"
            android:textColor="#FFFFFF"
            android:textSize="9sp"
            android:textStyle="bold" />

        <!-- Preview Icon -->
        <ImageView
            android:id="@+id/ivItemIcon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginTop="4dp"
            android:src="@drawable/family_owner_frame" />

        <!-- Title -->
        <TextView
            android:id="@+id/tvItemName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="sans-serif-black"
            android:gravity="center"
            android:maxLines="1"
            android:text="Golden Crown"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <!-- Description -->
        <TextView
            android:id="@+id/tvItemDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:maxLines="1"
            android:text="Exclusive profile frame"
            android:textColor="#88FFFFFF"
            android:textSize="11sp" />

        <!-- Action / Buy Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAction"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#FFD700"
            android:fontFamily="sans-serif-bold"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="300 🪙"
            android:textColor="#050E1E"
            android:textSize="12sp"
            app:cornerRadius="19dp" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
