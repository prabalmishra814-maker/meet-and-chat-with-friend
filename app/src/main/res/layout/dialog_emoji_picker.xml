<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_glass_more_panel"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <!-- Top Drag Handle Indicator Pill -->
    <View
        android:layout_width="40dp"
        android:layout_height="5dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_indicator_gradient" />

    <!-- Header Title -->
    <TextView
        android:id="@+id/tvEmojiTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="10dp"
        android:text="Animated Emojis 😀"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:textStyle="bold" />

    <!-- Category Tabs Bar -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:scrollbars="none"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tabEmojiAll"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_wallet_chip_selected"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="All 🌟"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tabEmojiReactions"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_wallet_chip_unselected"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="Reactions 😀"
                android:textColor="#A0FFFFFF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tabEmojiLove"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_wallet_chip_unselected"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="Love ❤️"
                android:textColor="#A0FFFFFF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tabEmojiParty"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_wallet_chip_unselected"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="Party 🎉"
                android:textColor="#A0FFFFFF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tabEmojiExpressive"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_wallet_chip_unselected"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="Expressive 🔥"
                android:textColor="#A0FFFFFF"
                android:textSize="12sp" />

        </LinearLayout>
    </HorizontalScrollView>

    <!-- Emoji Grid Recycler View -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvEmojiGrid"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:spanCount="4" />

</LinearLayout>
