<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_comment_sheet"
    android:orientation="vertical"
    android:padding="20dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/tvPrivateRoomTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:text="Private Room PIN"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnClosePinDialog"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_alignParentEnd="true"
            android:contentDescription="Close"
            android:src="@drawable/ic_close"
            app:tint="#88FFFFFF" />
    </RelativeLayout>

    <ImageView
        android:id="@+id/ivPrivateRoomBanner"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginVertical="12dp"
        android:contentDescription="Lock Banner"
        android:src="@drawable/ic_lock"
        app:tint="#FFD700" />

    <EditText
        android:id="@+id/etEnterPin"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginVertical="12dp"
        android:autofillHints="password"
        android:background="@drawable/search_bar_bg"
        android:hint="Enter Room PIN..."
        android:inputType="numberPassword"
        android:paddingHorizontal="16dp"
        android:textColor="#FFFFFF"
        android:textColorHint="#60FFFFFF"
        android:textSize="16sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnUnlockRoom"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Unlock Room"
        android:textColor="#050E1E"
        android:textStyle="bold"
        app:backgroundTint="#FFD700"
        app:cornerRadius="12dp" />

</LinearLayout>
