<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Layer 1: Premium Dark Space Canvas -->
    <item>
        <shape>
            <gradient
                android:angle="270"
                android:centerColor="#081121"
                android:endColor="#050810"
                android:startColor="#0A0E1A"
                android:type="linear" />
        </shape>
    </item>

    <!-- Layer 2: Top Soft Ambient Blue Glow -->
    <item
        android:left="-50dp"
        android:right="-50dp"
        android:top="-100dp"
        android:height="320dp">
        <shape android:shape="oval">
            <gradient
                android:centerX="50%"
                android:centerY="20%"
                android:endColor="#00000000"
                android:gradientRadius="260dp"
                android:startColor="#251E88E5"
                android:type="radial" />
        </shape>
    </item>

    <!-- Layer 3: Bottom Soft Ambient Cyan Glow -->
    <item
        android:bottom="-120dp"
        android:left="-50dp"
        android:right="-50dp"
        android:height="360dp">
        <shape android:shape="oval">
            <gradient
                android:centerX="50%"
                android:centerY="80%"
                android:endColor="#00000000"
                android:gradientRadius="300dp"
                android:startColor="#1A00FFC6"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
